{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "georumble",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../client/dist",
    "binding": "AppAssets",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "BROKER", "class_name": "RoomBroker" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "RoomBroker"] }],
  // Optional: bind a KV namespace and write a number or {"maxRooms": N} to the
  // "limits" key to retune the room-capacity gate without a redeploy. Unbound
  // keeps LIMITS_KV undefined and capacity falls back to plan detection.
  // "kv_namespaces": [{ "binding": "LIMITS_KV", "id": "<namespace-id>" }]
}
